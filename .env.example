# ---- core -------------------------------------------------------------
CCAS_ENV=local
CCAS_LOG_LEVEL=INFO
CCAS_DEFAULT_DOMAIN=retail
CCAS_DOMAINS_DIR=./domains
CCAS_CONFIG_DIR=./configs

# ---- llm providers (Rule 6: no node depends on a single model) ---------
# OpenRouter is the configured provider (ADR-0012). The free models it fronts are
# usable on the chat path at ~2,000 ms and 22x too slow for the voice router.
OPENROUTER_API_KEY=
CCAS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CCAS_OPENROUTER_REFERER=
CCAS_OPENROUTER_TITLE=ai-ccas
CCAS_LLM_DEFAULT_PROVIDER=openrouter

# Anthropic binding. Leave unset to let the SDK resolve its own credentials
# (env var, auth token, `ant auth login` profile, workload identity).
ANTHROPIC_API_KEY=
# vLLM binding (OpenAI-compatible). Point at your own server.
CCAS_VLLM_BASE_URL=http://localhost:8000/v1
CCAS_VLLM_API_KEY=not-needed

# ---- voice (Phase 5 -- FROZEN, ADR-0018; runs under `make voice`) -----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CCAS_CARTESIA_VOICE_ID=

# ---- infra ------------------------------------------------------------
CCAS_QDRANT_URL=http://localhost:6333
CCAS_REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-ccas

# ---- redaction (Rule 2: local inference only) -------------------------
CCAS_REDACTION_POLICY=./configs/redaction_policy.yaml
CCAS_PRESIDIO_ONNX_PATH=
# Never set this outside tests. Egress with unredacted text is a Rule 2 violation.
CCAS_ALLOW_REDACTION_BYPASS=false
